---
import "@fontsource-variable/martian-mono/wdth.css";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Beer de Vreeze" />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Beer de Vreeze: I build AI agents that finish real work." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0f0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe7d2" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
