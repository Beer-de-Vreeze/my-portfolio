---
import "@fontsource-variable/martian-mono/wdth.css";
import "../styles/global.css";
import GlyphFigure from "../components/GlyphFigure.astro";
import { loadContent } from "../data/content";

const { site, runs, projects, earlier } = await loadContent();

const title = `${site.name} - AI Engineer`;
const description = `${site.line} ${site.role}. Projects: showhow, bunq Voice, Sable.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta name="theme-color" content="#0d0f0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe7d2" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
  </head>
  <body>
    <a class="skip" href="#work">Skip to work</a>

    <header class="hero" data-hero>
      <canvas class="field" aria-hidden="true" data-field></canvas>

      <div class="top" data-hero-top>
        <p class="wordmark">{site.name}</p>
        <nav aria-label="Sections">
          <a href="#work">Work</a>
          <a href="#earlier">Earlier</a>
          <a href="#about">About</a>
        </nav>
      </div>

      <div class="base" data-hero-base>
        <div class="intro">
          <h1><span class="sr-only">{site.name}. </span>{site.line}</h1>
          <p class="role">{site.role}. Before that: game developer, and before that, a chef.</p>
          <a class="control action" href={`mailto:${site.email}`}>Email {site.email}</a>
        </div>

        <section class="run" aria-labelledby="run-title" data-run data-runs={JSON.stringify(runs)}>
          <div class="run-head">
            <h2 id="run-title" class="run-title">Demo run</h2>
            <div class="run-tabs" role="group" aria-label="Choose a demo run">
              {runs.map((run, i) => (
                <button type="button" class="control" data-run-tab aria-pressed={i === 0 ? "true" : "false"}>
                  {run.project}
                </button>
              ))}
            </div>
          </div>
          <pre class="run-log" data-run-log>{`> ${runs[0].prompt}`}</pre>
        </section>
      </div>
    </header>

    <main>
      <section id="work" class="work" aria-labelledby="work-title">
        <h2 id="work-title" class="rule section-title"><span>Work</span></h2>

        {projects.map((p) => (
          <article class="project" id={p.id} aria-labelledby={`${p.id}-title`}>
            <h3 id={`${p.id}-title`} class="project-title">{p.title}</h3>
            <div class="project-grid">
              <div class="copy">
                <p class="summary">{p.summary}</p>
                {p.body.map((para) => <p>{para}</p>)}
                <dl class="facts">
                  {p.facts.map((f) => (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>{f.value}</dd>
                    </div>
                  ))}
                </dl>
                {p.links.length > 0 && (
                  <p class="links">
                    {p.links.map((l) => (
                      <a class="control" href={l.href ?? "#"} rel="noopener">{l.label}<span class="sr-only"> for {p.title}</span></a>
                    ))}
                  </p>
                )}
              </div>

              <div class="side">
                {p.video && (
                  <figure class="video" data-glyph-video data-glyph-size="6">
                    <div class="screen">
                      <video playsinline preload="metadata" poster={p.video.poster}>
                        <source src={p.video.src} type="video/mp4" />
                        <track kind="captions" src={p.video.captions} srclang="en" label="English" />
                      </video>
                      <canvas aria-hidden="true"></canvas>
                      <button type="button" class="control play" data-video-play>Play demo</button>
                    </div>
                    <div class="vbar" role="group" aria-label="Video controls">
                      <input type="range" class="seek" min="0" max="46.5" step="0.1" value="0" aria-label="Seek" data-v-seek />
                      <button type="button" class="control" data-v-toggle>Play</button>
                      <span class="time" data-v-time>0:00 / 0:46</span>
                      <button type="button" class="control" data-v-mute>Mute</button>
                      <button type="button" class="control" data-v-cc>CC off</button>
                      <button type="button" class="control" aria-pressed="false" data-v-full>Fullscreen</button>
                    </div>
                    <figcaption>{p.video.label}</figcaption>
                  </figure>
                )}

                <div class="manifest">
                  <h4 class="rule"><span>{p.manifestTitle}</span></h4>
                  <dl>
                    {p.manifest.map((m) => (
                      <div>
                        <dt>{m.name}</dt>
                        <dd>{m.does}</dd>
                      </div>
                    ))}
                  </dl>
                </div>

                {p.media.length > 0 && (
                  <div class="shots">
                    {p.media.map((m) => m.image && <GlyphFigure src={m.image} alt={m.alt} caption={m.caption || undefined} ratio={m.ratio || "4 / 3"} position="50% 0%" glyphSize={5} />)}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </section>

      <section id="earlier" class="earlier" aria-labelledby="earlier-title">
        <h2 id="earlier-title" class="rule section-title"><span>Earlier: games and tools</span></h2>
        <p class="lede">Where I learned to build systems: Unity, C#, enemy AI and editor tooling.</p>
        <ul class="cells">
          {earlier.map((g) => (
            <li>
              <a href={g.href} rel="noopener">
                {g.image && <GlyphFigure src={g.image} alt={g.alt} ratio="4 / 3" glyphSize={6} />}
                <span class="cell-title">{g.title}</span>
              </a>
              <p>{g.what}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="about" class="about" aria-labelledby="about-title">
        <h2 id="about-title" class="rule section-title"><span>About</span></h2>
        <div class="about-grid">
          {site.portrait && <GlyphFigure src={site.portrait} alt={site.portraitAlt} ratio="3 / 4" glyphSize={6} />}
          <div class="about-copy">
            <p class="summary">{site.aboutLead}</p>
            {site.about.map((para) => <p>{para}</p>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="rule section-title"><span>Get in touch</span></h2>
      <p class="contact-line">Hiring for AI engineering, or need an agent, skill or MCP server built?</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="links">
        {site.links.map((l) => <a class="control" href={l.href} rel="noopener">{l.label}</a>)}
      </p>
    </footer>

    <script>
      import { startHeroField } from "../scripts/hero";
      import { startRuns } from "../scripts/run";
      import { startGlyphMedia } from "../scripts/media";

      const field = document.querySelector<HTMLCanvasElement>("[data-field]");
      const run = document.querySelector<HTMLElement>("[data-run]");
      document.fonts.ready.then(() => {
        if (field) startHeroField(field, (w) => (w < 600 ? ["BEER", "DE", "VREEZE"] : ["BEER DE", "VREEZE"]));
        startGlyphMedia();
      });
      if (run) startRuns(run, JSON.parse(run.dataset.runs || "[]"));
    </script>
  </body>
</html>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0 var(--gutter);
    isolation: isolate;
  }

  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2ch;
    padding: 1.25rem 0;
  }

  .wordmark {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: 2.5ch;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover {
    color: var(--ink);
  }

  .base {
    grid-row: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-bottom: clamp(1.25rem, 4vh, 2.5rem);
  }

  .intro,
  .run {
    background: var(--ground);
    padding: 1.25rem 1.5rem;
  }

  .intro {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: 44ch;
  }

  h1 {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .role {
    color: var(--muted);
  }

  .action {
    font-weight: 600;
  }

  .run {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .run-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2ch;
  }

  .run-title {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
  }

  .run-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5ch;
    font-size: var(--step--1);
  }

  .run-tabs .control {
    padding-inline: 0.4ch;
  }

  .run-log {
    margin: 0;
    min-height: calc(8 * 1.7em);
    font: inherit;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  main,
  .contact {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .section-title {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    margin: clamp(5rem, 12vw, 9rem) 0 2.5rem;
  }

  .project + .project {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .project-title {
    font-size: var(--step-3);
    font-weight: 800;
    font-stretch: 87.5%;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 1.75rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .copy {
    display: grid;
    gap: 1rem;
    max-width: 62ch;
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text);
    font-weight: 600;
  }

  .copy > p:not(.summary):not(.links) {
    color: var(--muted);
  }

  .facts {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
  }

  .facts div,
  .manifest dl div {
    display: grid;
    grid-template-columns: 12ch minmax(0, 1fr);
    gap: 2ch;
  }

  .facts dt {
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.5ch;
    margin-top: 0.5rem;
  }

  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    min-width: 0;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 40rem;
  }

  .video {
    display: grid;
    gap: 0.75rem;
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ground-raised);
  }

  .screen video,
  .screen canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .screen canvas {
    background: var(--ground-raised);
    cursor: pointer;
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hovering a paused video shows the real frame under the glyphs. */
  @media (hover: hover) {
    .screen:hover canvas {
      opacity: 0;
    }
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 0.4em 1ch;
    background: var(--ground);
    font-weight: 600;
  }

  /* Glyphs while stopped or paused; the real video, with its controls, while it plays. */
  .video.is-playing canvas,
  .video.is-playing .play {
    display: none;
  }

  .screen:fullscreen {
    background: #000;
  }

  .screen:fullscreen video {
    object-fit: contain;
  }

  /* Controls in the page's own grammar: bracket buttons and a seek line drawn in ink. */
  .vbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1ch;
    font-size: var(--step--1);
  }

  .vbar .control {
    padding-inline: 0.4ch;
  }

  .vbar [data-v-toggle] {
    min-width: 9ch;
    justify-content: center;
  }

  .time {
    margin-right: auto;
    color: var(--muted);
    white-space: nowrap;
  }

  .seek {
    flex: 1 0 100%;
    height: 1.5rem;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(to right, var(--ink) var(--p, 0%), var(--line) var(--p, 0%));
  }

  .seek::-moz-range-track {
    height: 2px;
    background: linear-gradient(to right, var(--ink) var(--p, 0%), var(--line) var(--p, 0%));
  }

  .seek::-webkit-slider-thumb {
    appearance: none;
    width: 0.6rem;
    height: 1rem;
    margin-top: calc(-0.5rem + 1px);
    background: var(--ink);
    border: 0;
  }

  .seek::-moz-range-thumb {
    width: 0.6rem;
    height: 1rem;
    background: var(--ink);
    border: 0;
    border-radius: 0;
  }

  .video figcaption {
    display: grid;
    gap: 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .manifest h4 {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .manifest dl {
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .manifest dl div {
    grid-template-columns: minmax(0, 22ch) minmax(0, 1fr);
  }

  .manifest dt {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .manifest dd {
    color: var(--muted);
  }

  .lede {
    max-width: 62ch;
    color: var(--muted);
    margin-bottom: 2.5rem;
  }

  .cells {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .cells li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .cells a {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
  }

  .cells :global(.frame) {
    cursor: pointer;
  }

  .cell-title {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-underline-offset: 0.3em;
  }

  .cells a:hover .cell-title {
    color: var(--ink);
  }

  .cells p {
    font-size: var(--step--1);
    color: var(--muted);
    line-height: 1.6;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .about-copy {
    display: grid;
    gap: 1rem;
    max-width: 62ch;
  }

  .about-copy p:not(.summary) {
    color: var(--muted);
  }

  .contact {
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }

  .contact-line {
    color: var(--muted);
    max-width: 52ch;
  }

  .email {
    display: inline-block;
    margin: 1.25rem 0 1.5rem;
    font-size: var(--step-3);
    font-weight: 800;
    font-stretch: 87.5%;
    letter-spacing: -0.03em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 60rem) {
    .base,
    .project-grid,
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .base {
      gap: 1rem;
    }

  }

  @media (max-width: 36rem) {
    .hero {
      min-height: auto;
      grid-template-rows: auto minmax(34svh, 1fr) auto;
    }

    nav {
      gap: 1.5ch;
      font-size: var(--step--1);
    }

    .wordmark {
      font-size: var(--step--1);
    }

    .intro,
    .run {
      padding: 1rem;
    }

    .run-log {
      font-size: 0.6875rem;
    }

    .run-tabs {
      gap: 0.5ch;
    }

    .facts div,
    .manifest dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
